{
  "name": "@circle-rd/auth-ai",
  "version": "0.1.0",
  "description": "TypeScript SDK for applications relying on the CIRCLE auth-service identity provider: OIDC sign-in, entitlements, billing, wallet and LiteLLM gateway.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/circle-rd/auth-ai.git"
  },
  "homepage": "https://github.com/circle-rd/auth-ai",
  "bugs": {
    "url": "https://github.com/circle-rd/auth-ai/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "jose": "^6.2.14",
    "openid-client": "^6.8.8",
    "zod": "^4.6.7"
  }
}
